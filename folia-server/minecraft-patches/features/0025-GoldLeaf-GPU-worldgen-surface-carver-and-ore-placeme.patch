+    // GoldLeaf start - compact column-major uint32 bitset export for GPU carver aquifer pass
+    public int[] goldleaf$packColumnMasks(final int minBlockY, final int wordsPerCol) {
+        final int[] out = new int[256 * wordsPerCol];
+        int startIndex = this.mask.nextSetBit(0);
+        while (startIndex != -1) {
+            final int endIndex = this.mask.nextClearBit(startIndex) - 1;
+            final int startColumn = startIndex / this.height;
+            final int endColumn = endIndex / this.height;
+            for (int column = startColumn; column <= endColumn; column++) {
+                final int x = (column >> 4) & 15;
+                final int z = column & 15;
+                final int colBase = column * this.height;
+                final int bottomY = Math.max(startIndex - colBase, 0) + this.minY;
+                final int topY = Math.min(endIndex - colBase, this.height - 1) + this.minY;
+                final int tid = (z << 4) | x;
+                final int dstBase = tid * wordsPerCol;
+                for (int y = bottomY; y <= topY; y++) {
+                    final int relY = y - minBlockY;
+                    final int wIdx = relY >>> 5;
+                    if (wIdx >= 0 && wIdx < wordsPerCol) {
+                        out[dstBase + wIdx] |= (1 << (relY & 31));
+                    }
+                }
+            }
+            startIndex = this.mask.nextSetBit(endIndex + 1);
+        }
+        return out;
+    }
+    // GoldLeaf end - compact column-major uint32 bitset export for GPU carver aquifer pass
