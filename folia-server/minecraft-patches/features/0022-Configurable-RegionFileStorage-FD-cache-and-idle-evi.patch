+    // GoldLeaf start - configurable RegionFile FD cache cap and idle eviction
+    int goldleaf$resolveCacheSize() {
+        final int sysProp = Integer.getInteger("goldleaf.regionFileCacheSize", -1);
+        if (sysProp >= 1) {
+            return sysProp;
+        }
+        final int paperCap = io.papermc.paper.configuration.GlobalConfiguration.get() == null
+            ? MAX_CACHE_SIZE
+            : io.papermc.paper.configuration.GlobalConfiguration.get().misc.regionFileCacheSize;
+        final dev.leafcraft.goldleaf.config.GoldLeafConfig gl = dev.leafcraft.goldleaf.config.GoldLeafConfig.get();
+        if (gl != null && gl.storage != null && gl.storage.maxOpenRegions >= 1) {
+            return Math.min(Math.max(1, paperCap), gl.storage.maxOpenRegions);
+        }
+        return Math.max(1, paperCap);
+    }
+
+    long goldleaf$resolveIdleTimeoutNanos() {
+        final int sysProp = Integer.getInteger("goldleaf.regionFileIdleTimeoutSeconds", -1);
+        if (sysProp >= 0) {
+            return sysProp * 1_000_000_000L;
+        }
+        final dev.leafcraft.goldleaf.config.GoldLeafConfig gl = dev.leafcraft.goldleaf.config.GoldLeafConfig.get();
+        if (gl != null && gl.storage != null && gl.storage.regionFileIdleTimeoutSeconds > 0) {
+            return gl.storage.regionFileIdleTimeoutSeconds * 1_000_000_000L;
+        }
+        return 0L;
+    }
+
+    public synchronized int evictIdleRegionFiles(final long nowNanos, final long idleTimeoutNanos) throws IOException {
+        this.lastIdleEvictNanos = nowNanos;
+        if (idleTimeoutNanos <= 0L || this.regionCache.isEmpty()) {
+            return 0;
+        }
+        int evictedCount = 0;
+        final ExceptionCollector<IOException> exceptionCollector = new ExceptionCollector<>();
+        while (!this.regionCache.isEmpty()) {
+            final long oldestKey = this.regionCache.lastLongKey();
+            final long lastAccess = this.regionLastAccessNanos.getOrDefault(oldestKey, nowNanos);
+            if (nowNanos - lastAccess < idleTimeoutNanos) {
+                break;
+            }
+            final Optional<RegionFile> evicted = this.regionCache.removeLast();
+            this.regionLastAccessNanos.remove(oldestKey);
+            if (evicted.isPresent()) {
+                try {
+                    evicted.get().close();
+                    evictedCount++;
+                } catch (final IOException ex) {
+                    exceptionCollector.add(ex);
+                }
+            }
+        }
+        exceptionCollector.throwIfPresent();
+        return evictedCount;
+    }
+
+    public synchronized int getCachedRegionFileCount() {
+        return this.regionCache.size();
+    }
+    // GoldLeaf end - configurable RegionFile FD cache cap and idle eviction
