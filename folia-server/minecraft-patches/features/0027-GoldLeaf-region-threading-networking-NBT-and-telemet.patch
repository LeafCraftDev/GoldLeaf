diff --git a/net/minecraft/network/CompressionEncoder.java b/net/minecraft/network/CompressionEncoder.java
index ac095f59d9f17d8239d6493d1c1e3942139b039f..e7cc9e1d1eb5148903a9a578639b4a0e6e145708 100644
--- a/net/minecraft/network/CompressionEncoder.java
+++ b/net/minecraft/network/CompressionEncoder.java
@@ -28,6 +28,40 @@ public class CompressionEncoder extends MessageToByteEncoder<ByteBuf> {
         // Paper end - Use Velocity cipher
     }
 
+    // GoldLeaf start - O(1) VarInt(0) Zlib bypass for already-compressed LCA_NET_V1 chunk batches
+    private static final byte[] GOLDLEAF_LCA_BATCH_CHANNEL_PREFIX =
+        "\u0019leafanvil:lca_chunk_batch".getBytes(java.nio.charset.StandardCharsets.US_ASCII);
+
+    private static boolean goldleaf$isPrecompressedLcaChunkBatch(final ByteBuf uncompressed, final int readableBytes) {
+        final byte[] needle = GOLDLEAF_LCA_BATCH_CHANNEL_PREFIX;
+        if (readableBytes < needle.length + 2) {
+            return false;
+        }
+        final int base = uncompressed.readerIndex();
+        // Custom payload packet ID is a 1- or 2-byte VarInt followed immediately by the length-prefixed channel ID.
+        for (int offset = 1; offset <= 3; offset++) {
+            if (base + offset + needle.length > base + readableBytes) {
+                break;
+            }
+            if (uncompressed.getByte(base + offset) == needle[0]
+                && uncompressed.getByte(base + offset + 1) == needle[1]
+                && uncompressed.getByte(base + offset + needle.length - 1) == needle[needle.length - 1]) {
+                boolean match = true;
+                for (int i = 2; i < needle.length - 1; i++) {
+                    if (uncompressed.getByte(base + offset + i) != needle[i]) {
+                        match = false;
+                        break;
+                    }
+                }
+                if (match) {
+                    return true;
+                }
+            }
+        }
+        return false;
+    }
+    // GoldLeaf end
+
     @Override
     protected void encode(final ChannelHandlerContext ctx, final ByteBuf uncompressed, final ByteBuf out) throws Exception { // Paper - Use Velocity cipher
         int uncompressedLength = uncompressed.readableBytes();
@@ -35,7 +69,7 @@ public class CompressionEncoder extends MessageToByteEncoder<ByteBuf> {
             throw new IllegalArgumentException("Packet too big (is " + uncompressedLength + ", should be less than 8388608)");
         }
 
-        if (uncompressedLength < this.threshold) {
+        if (uncompressedLength < this.threshold || goldleaf$isPrecompressedLcaChunkBatch(uncompressed, uncompressedLength)) {
             VarInt.write(out, 0);
             out.writeBytes(uncompressed);
         } else {
