+        if (this.slots.size() > 1) {
+            for (final Pair<EquipmentSlot, ItemStack> slot : this.slots) {
+                manager.send(new ClientboundSetEquipmentPacket(this.entity, List.of(slot), this.sanitize));
+            }
+            return true;
+        }
+        if (this.slots.size() == 1) {
+            final Pair<EquipmentSlot, ItemStack> only = this.slots.getFirst();
+            final ItemStack stack = only.getSecond();
+            if (!stack.isEmpty() && !stack.getComponentsPatch().isEmpty()) {
+                com.mojang.logging.LogUtils.getLogger().warn(
+                    "Equipment packet for entity {} slot {} ({}) exceeded max packet size; sending stripped visual item fallback",
+                    this.entity, only.getFirst(), stack.getItem()
+                );
+                manager.send(new ClientboundSetEquipmentPacket(
+                    this.entity,
+                    List.of(Pair.of(only.getFirst(), new ItemStack(stack.getItem(), stack.getCount()))),
+                    this.sanitize
+                ));
+                return true;
+            }
+        }
+        com.mojang.logging.LogUtils.getLogger().warn(
+            "Equipment packet for entity {} exceeded max packet size and could not be reduced; skipping packet",
+            this.entity
+        );
+        return true;
+    }
+    // GoldLeaf end - chunk-ban protection: split or strip oversized equipment packets
+
     public int getEntity() {
         return this.entity;
     }
