diff --git a/net/minecraft/network/protocol/game/ClientboundLevelChunkWithLightPacket.java b/net/minecraft/network/protocol/game/ClientboundLevelChunkWithLightPacket.java
index 1b83d541378c98e3517904973e3ea4e33098a914..c4981815de6c3e659f1c6907a84fafd0d12fea68 100644
--- a/net/minecraft/network/protocol/game/ClientboundLevelChunkWithLightPacket.java
+++ b/net/minecraft/network/protocol/game/ClientboundLevelChunkWithLightPacket.java
@@ -86,4 +86,29 @@ public record ClientboundLevelChunkWithLightPacket(int x, int z, ClientboundLeve
         return this.chunkData.getExtraPackets();
     }
     // Paper end - Handle oversized block entities in chunks
+    // GoldLeaf start - chunk-ban protection: split oversized chunk packet into bare chunk + individual BE updates
+    @Override
+    public boolean hasLargePacketFallback() {
+        return true;
+    }
+
+    @Override
+    public boolean packetTooLarge(final net.minecraft.network.Connection manager) {
+        if (!this.chunkData.hasBlockEntities()) {
+            return false;
+        }
+        com.mojang.logging.LogUtils.getLogger().warn(
+            "Chunk packet at ({}, {}) exceeded max packet size; resending chunk without inline block entities and splitting block entity updates",
+            this.x, this.z
+        );
+        manager.send(new ClientboundLevelChunkWithLightPacket(this.x, this.z, this.chunkData.withoutBlockEntities(), this.lightData));
+        this.chunkData.forEachBlockEntityTag(this.x, this.z, (pos, type, tag) -> {
+            manager.send(new ClientboundBlockEntityDataPacket(pos.immutable(), type, tag != null ? tag : new net.minecraft.nbt.CompoundTag()));
+        });
+        for (final Packet<?> extra : this.chunkData.getExtraPackets()) {
+            manager.send(extra);
+        }
+        return true;
+    }
+    // GoldLeaf end - chunk-ban protection: split oversized chunk packet into bare chunk + individual BE updates
 }
diff --git a/net/minecraft/network/protocol/game/ClientboundSetEntityDataPacket.java b/net/minecraft/network/protocol/game/ClientboundSetEntityDataPacket.java
index b8b04a7797259e84d5cc4f1818fe9b7c5e3da908..8442ebbe57ee7ec793ad5ee67448f622650364de 100644
--- a/net/minecraft/network/protocol/game/ClientboundSetEntityDataPacket.java
+++ b/net/minecraft/network/protocol/game/ClientboundSetEntityDataPacket.java
@@ -53,4 +53,51 @@ public record ClientboundSetEntityDataPacket(int id, List<SynchedEntityData.Data
     public void handle(final ClientGamePacketListener listener) {
         listener.handleSetEntityData(this);
     }
+
+    // GoldLeaf start - chunk-ban protection: split or strip oversized entity metadata packets
+    @Override
+    public boolean hasLargePacketFallback() {
+        return true;
+    }
+
+    @SuppressWarnings("unchecked")
+    @Override
+    public boolean packetTooLarge(final net.minecraft.network.Connection manager) {
+        if (this.packedItems.size() > 1) {
+            for (final SynchedEntityData.DataValue<?> item : this.packedItems) {
+                manager.send(new ClientboundSetEntityDataPacket(this.id, List.of(item)));
+            }
+            return true;
+        }
+        if (this.packedItems.size() == 1) {
+            final SynchedEntityData.DataValue<?> only = this.packedItems.getFirst();
+            if (only.value() instanceof net.minecraft.world.item.ItemStack stack
+                && !stack.isEmpty()
+                && !stack.getComponentsPatch().isEmpty()) {
+                com.mojang.logging.LogUtils.getLogger().warn(
+                    "Entity metadata packet for entity {} data id {} ({}) exceeded max packet size; sending stripped visual item fallback",
+                    this.id, only.id(), stack.getItem()
+                );
+                final net.minecraft.world.item.ItemStack stripped = new net.minecraft.world.item.ItemStack(stack.getItem(), stack.getCount());
+                final SynchedEntityData.DataValue<net.minecraft.world.item.ItemStack> fallback = new SynchedEntityData.DataValue<>(
+                    only.id(),
+                    (net.minecraft.network.syncher.EntityDataSerializer<net.minecraft.world.item.ItemStack>) only.serializer(),
+                    stripped
+                );
+                manager.send(new ClientboundSetEntityDataPacket(this.id, List.of(fallback)));
+                return true;
+            }
+            com.mojang.logging.LogUtils.getLogger().warn(
+                "Entity metadata packet for entity {} data id {} exceeded max packet size; skipping oversized entry",
+                this.id, only.id()
+            );
+            return true;
+        }
+        com.mojang.logging.LogUtils.getLogger().warn(
+            "Entity metadata packet for entity {} exceeded max packet size; skipping packet",
+            this.id
+        );
+        return true;
+    }
+    // GoldLeaf end - chunk-ban protection: split or strip oversized entity metadata packets
 }
