diff --git a/net/minecraft/network/protocol/game/ClientboundBlockEntityDataPacket.java b/net/minecraft/network/protocol/game/ClientboundBlockEntityDataPacket.java
index 2122ff56412a2ad412eb8b2f0e4538aab4257bf2..c4166e34d690624919417e2db1563eae8f4edc66 100644
--- a/net/minecraft/network/protocol/game/ClientboundBlockEntityDataPacket.java
+++ b/net/minecraft/network/protocol/game/ClientboundBlockEntityDataPacket.java
@@ -65,4 +65,24 @@ public class ClientboundBlockEntityDataPacket implements Packet<ClientGamePacket
     public CompoundTag getTag() {
         return this.tag;
     }
+
+    // GoldLeaf start - chunk-ban protection: downgrade single oversized block entity update to empty NBT
+    @Override
+    public boolean hasLargePacketFallback() {
+        return true;
+    }
+
+    @Override
+    public boolean packetTooLarge(final net.minecraft.network.Connection manager) {
+        if (this.tag.isEmpty()) {
+            return false;
+        }
+        com.mojang.logging.LogUtils.getLogger().warn(
+            "Block entity update packet at {} ({}) exceeded max packet size; sending empty NBT fallback to prevent client disconnect",
+            this.pos, this.type
+        );
+        manager.send(new ClientboundBlockEntityDataPacket(this.pos, this.type, new CompoundTag()));
+        return true;
+    }
+    // GoldLeaf end - chunk-ban protection: downgrade single oversized block entity update to empty NBT
 }
diff --git a/net/minecraft/network/protocol/game/ClientboundContainerSetSlotPacket.java b/net/minecraft/network/protocol/game/ClientboundContainerSetSlotPacket.java
index 1879ed63e5bf1d39756e69b1943a72c0769fcfe7..b398b19770a062eea2dd2e2bda9fd18695ca8f69 100644
--- a/net/minecraft/network/protocol/game/ClientboundContainerSetSlotPacket.java
+++ b/net/minecraft/network/protocol/game/ClientboundContainerSetSlotPacket.java
@@ -61,4 +61,33 @@ public class ClientboundContainerSetSlotPacket implements Packet<ClientGamePacke
     public int getStateId() {
         return this.stateId;
     }
+
+    // GoldLeaf start - book-ban protection: strip visual item components on single oversized container slot
+    @Override
+    public boolean hasLargePacketFallback() {
+        return true;
+    }
+
+    @Override
+    public boolean packetTooLarge(final net.minecraft.network.Connection manager) {
+        if (!this.itemStack.isEmpty() && !this.itemStack.getComponentsPatch().isEmpty()) {
+            com.mojang.logging.LogUtils.getLogger().warn(
+                "Container slot packet (container={}, slot={}, item={}) exceeded max packet size; sending stripped visual item fallback",
+                this.containerId, this.slot, this.itemStack.getItem()
+            );
+            manager.send(new ClientboundContainerSetSlotPacket(
+                this.containerId,
+                this.stateId,
+                this.slot,
+                new ItemStack(this.itemStack.getItem(), this.itemStack.getCount())
+            ));
+            return true;
+        }
+        com.mojang.logging.LogUtils.getLogger().warn(
+            "Container slot packet (container={}, slot={}) exceeded max packet size and could not be reduced; skipping packet",
+            this.containerId, this.slot
+        );
+        return true;
+    }
+    // GoldLeaf end - book-ban protection: strip visual item components on single oversized container slot
 }
